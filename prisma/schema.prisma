datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Doctor {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  password     String
  regNumber    String?
  clinicName   String?
  specialty    String       @default("Ayurveda")
  phone        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  patients     Patient[]
  cases        CaseRecord[]
}

model Patient {
  id                   String            @id @default(uuid())
  doctorId             String
  doctor               Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  abhaId               String?           @unique
  name                 String
  age                  Int
  gender               String
  contact              String
  email                String?
  address              String?
  bloodGroup           String?
  allergies            String?
  prakritiType         String?
  
  // SIH Patient-First Pre-Consultation & AI History Fields
  preConsultationStatus String           @default("PENDING") // PENDING, IN_PROGRESS, SENT_TO_DOCTOR, REVIEWED
  language             String            @default("en")      // "en" | "hi"
  consentGiven         Boolean           @default(false)
  consentTimestamp     DateTime?
  chiefComplaint       String?
  duration             String?
  hpi                  String?           // History of Present Illness
  pastMedicalHistory   String?
  pastSurgicalHistory  String?
  currentMedicines     String?
  familyHistory        String?
  personalHistory      String?           // Lifestyle, Diet, Sleep, Bowel
  reviewOfSystems      String?
  ayushAgni            String?           // Samagni, Vishamagni, Tikshnagni, Mandagni
  ayushKoshta          String?           // Madhyama, Krura, Mridu
  aiSummary            String?           // Physician-Ready AI Clinical Summary (JSON or structured text)
  aiInterviewData      String?           // Full JSON transcript of conversational AI interview
  redFlags             String?           // Detected emergency red-flags JSON/string

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  cases                CaseRecord[]
  documents            MedicalDocument[]
}

model MedicalDocument {
  id            String   @id @default(uuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title         String
  docType       String   // Prescription, Lab Report, Discharge Summary, Imaging, Other
  docDate       DateTime @default(now())
  fileUrl       String?
  ocrText       String?
  extractedData String?  // JSON string: { diagnosis, medicines: [], labValues: [], procedures: [] }
  summary       String?
  uploadedBy    String   @default("patient") // patient | doctor
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CaseRecord {
  id                 String    @id @default(uuid())
  patientId          String
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  visitDate          DateTime  @default(now())
  
  // Clinical Notes & History
  chiefComplaint     String
  duration           String?
  hpi                String?   // History of Present Illness
  pastMedicalHistory String?
  familyHistory      String?
  
  // Prakriti Assessment
  vataScore          Int       @default(0)
  pittaScore         Int       @default(0)
  kaphaScore         Int       @default(0)
  prakritiResult     String?   // e.g. "Vata-Pitta dominant"
  prakritiAnswers    String?   // JSON string of answers
  
  // Ashtavidha Pariksha (Eight-Fold Ayurvedic Examination)
  nadiPariksha       String?   // Pulse examination
  jihvaPariksha      String?   // Tongue examination
  malaPariksha       String?   // Stool/Bowel examination
  mutraPariksha      String?   // Urine examination
  sparshaPariksha    String?   // Skin/Touch examination
  drukPariksha       String?   // Eyes examination
  shabdaPariksha     String?   // Voice/Speech examination
  aakritiPariksha    String?   // General build & posture
  
  // Digestive Fire & Bowel Nature
  agniType           String?   // Vishamagni, Tikshnagni, Mandagni, Samagni
  koshtaType         String?   // Krura, Mridu, Madhyama
  
  // Dual Diagnosis
  ayurvedicDiagnosis String    // e.g. "Amavata", "Amlapitta", "Sandhigatavata"
  modernDiagnosis    String?   // e.g. "Rheumatoid Arthritis (ICD-11: FA20)"
  prognosis          String?   // Sukha Sadhya, Krichra Sadhya, Asadhya, Yapya
  
  // Chikitsa (Treatment) & Prescription
  prescription       String    // JSON string array of medications: [{ name, form, dose, anupana, timing }]
  panchakarmaAdvice  String?   // Therapies (Abhyanga, Swedana, Shirodhara, Basti, etc.)
  pathyaDiet         String?   // Wholesome diet/habits (DOs)
  apathyaDiet        String?   // Unwholesome diet/habits (DONTs)
  lifestyleAdvice    String?   // Yoga asanas, Pranayama, Dinacharya
  followUpDate       DateTime?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
